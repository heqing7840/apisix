{
  "name": "wallpaper-manager",
  "version": "1.0.0",
  "description": "Cross-platform wallpaper management application with Pexels integration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "setup": "node setup.js",
    "test-api": "node test-api.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "postinstall": "node setup.js"
  },
  "keywords": [
    "wallpaper",
    "desktop",
    "pexels",
    "electron",
    "cross-platform"
  ],
  "author": "Wallpaper Manager Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "eslint": "^8.50.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "electron-store": "^8.1.0",
    "sharp": "^0.32.6",
    "node-cron": "^3.0.2",
    "fs-extra": "^11.1.1",
    "path": "^0.12.7",
    "dotenv": "^16.3.1"
  },
  "build": {
    "appId": "com.wallpapermanager.app",
    "productName": "Wallpaper Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "config/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
