# Pexels API Configuration
# Get your API key from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Application Environment
NODE_ENV=production

# Download Configuration
DEFAULT_DOWNLOAD_PATH=~/Wallpapers/Downloads
CACHE_PATH=~/Wallpapers/Cache
LOCAL_WALLPAPERS_PATH=~/Wallpapers/Local

# Cache Settings
MAX_CACHE_SIZE_MB=500
CACHE_EXPIRY_DAYS=30

# Rate Limiting
PEXELS_REQUESTS_PER_HOUR=200
PEXELS_REQUESTS_PER_MONTH=20000

# Performance Settings
MAX_CONCURRENT_DOWNLOADS=3
ENABLE_VIDEO_WALLPAPERS=true
DEFAULT_VIDEO_FRAME_RATE=30

# Privacy Settings
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=true
SHARE_USAGE_DATA=false

# Development Settings (only for development)
# ELECTRON_IS_DEV=true
# DEBUG_MODE=true
# ENABLE_DEV_TOOLS=true
